%info_requires \
Requires(post): %{?_sys_sbindir}%{!?_sys_sbindir:%{_sbindir}}/install-info.exe \
Requires(preun): %{?_sys_sbindir}%{!?_sys_sbindir:%{_sbindir}}/install-info.exe

%info_post() \
if [ -f %{_infodir}/%1 ]; then # --excludedocs? \
  %{?_sys_sbindir}%{!?_sys_sbindir:%{_sbindir}}/install-info.exe %{_infodir}/%1 %{_infodir}/dir || : \
fi

%info_preun() \
if [ $1 = 0 ]; then \
  if [ -f %{_infodir}/%1 ]; then # --excludedocs? \
    %{?_sys_sbindir}%{!?_sys_sbindir:%{_sbindir}}/install-info.exe --delete %{_infodir}/%1 %{_infodir}/dir || : \
  fi \
fi
