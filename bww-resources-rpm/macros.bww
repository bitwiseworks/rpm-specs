#
# Macros for the bitwise works default WPS object layout
#
# Any package using these macros must add the 'BuildFeatures: package-context'
# tag in the .spec file's preamble, along with the following dependency:
#
#   BuildFeatures: package-context
#   BuildRequires: rpm_macro(bww_folder)
#
# All WPS objects are created inside a dedicated WPS folder defined with the
# %bww_folder macro in the %post section of a .spec file. This macro must
# precede all other %bww_ macros in this section, except %bww_cleanup which must
# be used in the %postun section to perform automatic cleanup for all created
# WPS objects (including the WPS folder).
#
# The %bww_folder macro normally creates a per-package WPS folder. If it is
# necessary to share the same WPS folder across multiple packages, use the -s
# SHAREDID option. SHAREDID must be the same for all packages sharing this
# folder. The SHAREDID value participates only in the folder's Object ID. The
# shared folder itself is associated with the package it is used in. It will be
# created when the first associated package is installed, and deleted when the
# last associated package is removed.
#
# Note that SHAREDID must be unique across all RPM packages on the system. To
# avoid possible clashes, always use %{name}[-SUFFIX] for SHAREDID. SUFFIX is
# necessary in cases where the main .spec package already creates a non-shared
# WPS folder. Make sure that SUFFIX does not match the name of a sub-package (to
# avoid clashes with sub-packages creating non-shared folders).
#
# You may create one non-shared WPS folder per each package, and several shared
# folders, but each shared folder must have an unique SHAREDID.
#
# COMPATIBILITY NOTE: Previous versions required using -n with any %bww_ macro
# used in a sub-package. Now, -n is rejected with a build-time error, because
# [sub-]package association is established automatically.
#
# COMPATIBILITY NOTE 2: Previously, WPS object titles with spaces required the
# use of a %global macro to define them. In RPM 4.14+, this approach alone is no
# longer valid. Instead, use %{quote:TITLE} for such titles, even when TITLE is
# itself a macro, for example, %{quote:%{wps_title}}. Also, the -V option has
# been dropped. Now, -t TITLE does not append the package version to the title.
# Use -T TITLE to append it (or construct TITLE for -t yourself using
# %{package_version} and other per-package macros).
#
# All WPS objects must be created in the %post section, for example:
#
#   %post
#   ...
#   %bww_folder -t %{quote:My App}
#   %bww_readme ...
#   %bww_app -t %{quote:My App} ...
#
#   %post sub
#   ...
#   %bww_folder -t %{quote:My Sub App}
#   %bww_readme ...
#   %bww_app -t %{quote:My Sub App} ...
#
# All created WPS objects must be deleted in the %postun section:
#
#   %postun [SUBPACKAGE | -n PACKAGE]
#   ...
#   %bww_cleanup
#
# Additionally, always add the following dependency declarations in the metadata
# of each package that uses any of the %bww_ macros:
#
#   Requires(post): rpm_macro(bww_folder)
#   Requires(postun): rpm_macro(bww_cleanup)
#
# Some macros allow to customize the IDs of the created WPS objects. The
# following Object IDs are reserved and should not be used as customization
# arguments:
#
#  - FOLDER
#  - APP
#  - README
#  - LICENSE
#  - COPYRIGHT
#  - CHANGELOG
#  - DOCDIR
#

#
# bww_folder:
#
# Create the following objects:
#
# 1. The "bitwiseworks Help Center" folder with the WP_BWWHELP Object ID
#    located in the "Help Center" (WP_ASSISTANCE) folder
# 2. The "Package Documentation" object with the WP_BWWDOC Object ID as a shadow
#    of the %{_defaultdocdir} directory in the WP_BWWHELP folder
# 3. The "bitwiseworks Apps and Ports" folder with the WP_BWWAPPS Object ID
#    in the "Programs" (WP_PROGRAMSFOLDER) folder
# 4. A shadow of the WP_BWWHELP folder with the WP_BWWHELPSHADOW Object ID in
#    the WP_BWWAPPS folder
# 5. A package folder in the WP_BWWAPPS folder with a BWW_<pkg>_FOLDER Object ID
#    where <pkg> is the -s value if given, otherwise the full package name.
#
# WPS objects created at steps 1-4 are system-wide folders that normally already
# exist, so package installation simply updates their specification and
# reference counters.
#
# The WPS folder created at step 5 is the actual folder where package objects
# are created. It is created using the arguments provided below when the package
# is initially installed, and is deleted when the package is finally removed
# (unless it's a shared folder created with -s, as described above).
#
# A package upgrade or reinstall updates the folder and its objects according to
# the new package specifications. Shared folders only get updates of the folder
# itself and objects associated with this particular package, objects belognign
# to other packages are left intact.
#
# If it is necessary to fully recreate the package folder on each upgrade or
# reinstall, use the -R option. Note that it will undo all custom modifications
# applied to the folder by the user which may be undesirable. The -R option is
# ignored for shared folders.
#
# Arguments:
#
#   [{-t | -T} TITLE] [-s SHAREDID] [-R]
#
# - TITLE: Folder title (use %{quote:TITLE} if TITLE contains spaces); -T
#   automatically appends the package version to TITLE (takes precedence over -t
#   if both forms are used)
# - SHAREDID: Use SHAREDID as part of the folder's Object ID instead of the
#   effective full package name
#
# For normal folders (no -s given), TITLE is mandatory. For shared folders (-s),
# TITLE may be omitted for the second and all subsequent bww_folder macros using
# the same SHAREDID. Otherwise, the last macro's TITLE will determine the shared
# folder's title.
#
%bww_folder(t:T:s:R)\
%{!-t:%{!-T:%{!-s:%{_error_loc %0: Missing mandatory TITLE parameter}}}}\
%{!?buildfeature_package_context:%{_error_loc %0: Requires BuildFeatures: package-context}}\
%{!?package_scriptlet_post:%{_error_loc %0: Can appear only in post context}}\
%global __bww_package_id %{package_name}\
%global __bww_package_key %{_safe_macro_name %{__bww_package_id}}\
%global __bww_folder_name %{!-s:%{__bww_package_id}}%{-s:%{-s*}}\
%global __bww_folder_id BWW_%{__bww_folder_name}_FOLDER\
%global __bww_folder_option %{-R:%{!-s:|R}}\
%global __bww_folder_title %{-T:%{-T*} %{version}}%{!-T:%{-t*}}\
%{-s:\
%global __bww_sh_folder_key %{_safe_macro_name %{__bww_folder_name}}\
%{!-t:%{!-T:%{expand:\
%%{!?__bww_sh_folder_title_%{__bww_sh_folder_key}:%%{_error_loc %0: Missing TITLE parameter (first shared folder use)}}\
%{expand:%%global __bww_folder_title %%{__bww_sh_folder_title_%{__bww_sh_folder_key}}}\
}}}\
}\
%{-s:%{expand:%%global __bww_sh_folder_title_%{__bww_sh_folder_key} %%{__bww_folder_title}}}\
%undefine __bww_app_id\
%__bww_guard_package_use_of %{0} %{__bww_folder_id}\
%{expand:%%{!?__bww_common_created_%{__bww_package_key}:\
%%global __bww_common_created_%{__bww_package_key} 1\
%global __bww_help_folder_title bitwiseworks Help Center\
%global __bww_apps_folder_title bitwiseworks Apps and Ports\
%global __bww_doc_folder_title Package Documentation\
%wps_object_check_evr\
%wps_object_create WP_BWWHELP:WPFolder|%{__bww_help_folder_title}|<WP_ASSISTANCE>|SHOWALLINTREEVIEW=YES;ICONRESOURCE=60,PMWP.DLL;ICONNRESOURCE=83,PMWP.DLL;BACKGROUND=((%{_datadir}/os2/bww/bwwfbkg.bmp));ALWAYSSORT=YES;DEFAULTSORT=-1;DEFAULTVIEW=TREE;NODELETE=YES;\
%wps_object_create WP_BWWDOC:WPShadow|%{__bww_doc_folder_title}|<WP_BWWHELP>|SHADOWID=((%{_datadir}/doc));\
%wps_object_create WP_BWWAPPS:WPFolder|%{__bww_apps_folder_title}|<WP_PROGRAMSFOLDER>|ICONRESOURCE=1,BWWRES.DLL;ICONNFILE=((%{_datadir}/os2/bww/bwwfldro.ico));BACKGROUND=((%{_datadir}/os2/bww/bwwfbkg.bmp));ICONVIEW=FLOWED;\
%wps_object_create WP_BWWHELPSHADOW:WPShadow|%{__bww_help_folder_title}|<WP_BWWAPPS>|SHADOWID=<WP_BWWHELP>;\
}}\
%wps_object_create %{__bww_folder_id}:WPFolder|%{__bww_folder_title}|<WP_BWWAPPS>|OPEN=ICON;%{__bww_folder_option}\
%{nil}

#
# bww_folder_shadow:
#
# Create a shadow of the package folder created with the last %bww_folder macro
# in the given WPS destination (will get a BWW_<pkg>_FOLDER_<OBJECTID>_SHADOW
# Object ID)
#
# Arguments:
#
#   [-d OBJECTID]
#
# - OBJECTID: Destination for the shadow object without <> brackets (WP_DESKTOP
#   when omitted)
#
%bww_folder_shadow(d:)\
%{__bww_check_package_id}\
%global __bww_folder_shadowdest %{!-d:WP_DESKTOP}%{-d:%{-d*}}\
%global __bww_folder_shadow_id %{__bww_folder_id}_%{__bww_folder_shadowdest}_SHADOW\
%__bww_guard_package_use_of %{0} %{__bww_folder_shadow_id}\
%wps_object_create %{__bww_folder_shadow_id}:WPShadow|%{__bww_folder_title}|<%{__bww_folder_shadowdest}>|SHADOWID=<%{__bww_folder_id}>;\
%{nil}

#
# bww_app:
#
# Create a program object in the package folder created with the last
# %bww_folder macro (will get a BWW_<pkg>_<ID>_APP Object ID)
#
# Arguments:
#
#   [ID] -t TITLE -f EXE [-a ASSOCIATIONS] [-i ICON] [-d STARTUPDIR] [-p PARAMETERS] [-e EXTRA]
#
# - ID: ID to add to the Object ID (can be omitted)
# - TITLE: Program title (*must* be specified as %{quote:TITLE} if TITLE
#   contains spaces)
# - EXE: Full path/to/app.exe
# - ASSOCIATIONS: Associate a file filter with the program, for example: *.txt
#   or *.txt,*.pdf,*.html
# - ICON: Icon to set on the program object (the icon file needs to be copied to
#   %{_datadir}/os2/icons/ during installation)
# - STARTUPDIR: STARTUPDIR value for the program object
# - PARAMETERS: PARAMETERS value for the program object (arguments for EXE)
# - EXTRA: Value to append to the end of the WPProgram setup string
#
%bww_app(f:t:a:i:d:p:e:)\
%{!-f:%{_error_loc %0: Missing mandatory EXE parameter}}\
%{!-t:%{_error_loc %0: Missing mandatory TITLE parameter}}\
%{__bww_check_package_id}\
%global __bww_obj_id %{?1:_%{1}}%{!?1:}\
%global __bww_app_id BWW_%{__bww_package_id}%{__bww_obj_id}_APP\
%global __bww_app_title %{-t*}\
%global __bww_app_icon %{!-i:}%{-i:ICONFILE=((%{_datadir}/os2/icons/%{-i*}));}\
%global __bww_app_assoc %{!-a:}%{-a:ASSOCFILTER=%{-a*};}\
%global __bww_app_startupdir %{!-d:}%{-d:STARTUPDIR=((%{-d*}));}\
%global __bww_app_parameters %{!-p:}%{-p:PARAMETERS=%{-p*};}\
%global __bww_app_extra %{!-e:}%{-e:;%{-e*}}\
%global __bww_app_name %{-f*}\
%__bww_guard_package_use_of %{0} %{__bww_app_id}\
%wps_object_create %{__bww_app_id}:WPProgram|%{__bww_app_title}|<%{__bww_folder_id}>|EXENAME=((%{__bww_app_name}));%{__bww_app_startupdir}%{__bww_app_parameters};%{__bww_app_icon}%{__bww_app_assoc}%{__bww_app_extra}\
%{nil}

#
# bww_app_shadow:
#
# Create a shadow of the program object created with the last %bww_app macro in
# the given WPS destination (will get a BWW_<pkg>_<ID>_APP_<OBJECTID>_SHADOW
# Object ID)
#
# Arguments:
#
#   [-d OBJECTID]
#
# - OBJECTID: Destination for the shadow object without <> brackets (WP_DESKTOP
#   when omitted)
#
%bww_app_shadow(d:)\
%{__bww_check_package_id}\
%{!?__bww_app_id:%{_error_loc %0: Missing preceding bww_app macro}}\
%global __bww_app_shadowdest %{!-d:WP_DESKTOP}%{-d:%{-d*}}\
%global __bww_app_shadow_id %{__bww_app_id}_%{__bww_app_shadowdest}_SHADOW\
%__bww_guard_package_use_of %{0} %{__bww_app_shadow_id}\
%wps_object_create %{__bww_app_shadow_id}:WPShadow|%{__bww_app_title}|<%{__bww_app_shadowdest}>|SHADOWID=<%{__bww_app_id}>;\
%{nil}

#
# bww_readme:
#
# Create a shadow of the readme file in the package folder created with the last
# %bww_folder macro (will get a BWW_<pkg>_README Object ID)
#
# Arguments:
#
#   README_FILE
#
# - README_FILE: Relative path to the file in the package %doc directory
#
%bww_readme()\
%{!?1:%{_error_loc %0: Missing mandatory README_FILE parameter}}\
%bww_file README -D %{quote:%{1}}\
%{nil}

#
# bww_license:
#
# Creates a shadow of the license file in the package folder created with the
# last %bww_folder macro (will get a BWW_<pkg>_LICENSE Object ID)
#
# Arguments:
#
#   LICENSE_FILE
#
# - LICENSE_FILE: Relative path to the file in the package %license directory
#
%bww_license(L:)\
%{!?1:%{_error_loc %0: Missing mandatory LICENSE_FILE parameter}}\
%bww_file LICENSE -L %{quote:%{1}}\
%{nil}

#
# bww_copyright:
#
# Creates a shadow of a copyright file in the package folder created with the
# last %bww_folder macro (will get a BWW_<pkg>_COPYRIGHT Object ID)
#
# Arguments:
#
#   COPYRIGHT_FILE
#
# - COPYRIGHT_FILE: Relative path to the file in the package %license directory
#
%bww_copyright(L:)\
%{!?1:%{_error_loc %0: Missing mandatory COPYRIGHT_FILE parameter}}\
%bww_file COPYRIGHT -L %{quote:%{1}}\
%{nil}

#
# bww_changelog:
#
# Creates a shadow of a changelog file in the package folder created with the
# last %bww_folder macro (will get a BWW_<pkg>_CHANGELOG Object ID)
#
# Arguments:
#
#   CHANGELOG_FILE
#
# - CHANGELOG_FILE: Relative path to the file in the package %doc directory
#
%bww_changelog(D:)\
%{!?1:%{_error_loc %0: Missing mandatory CHANGELOG_FILE parameter}}\
%bww_file CHANGELOG -D %{quote:%{1}}\
%{nil}

#
# bww_docdir:
#
# Creates a shadow of the package %doc directory in the package folder created
# with the last %bww_folder macro (will get a BWW_<pkg>_DOCDIR Object ID)
#
%bww_docdir()\
%bww_file DOCDIR -D %{quote:}\
%{nil}

#
# bww_file:
#
# Create a shadow of the file in the package folder created with the last
# %bww_folder macro (will get a BWW_<pkg>_<ID> Object ID)
#
# Arguments:
#
#   ID { -f FILE | -D DOC_FILE | -L LICENSE_FILE }
#
# - ID: ID to add to the Object ID
# - FILE: Full path to the file to create a shadow for
# - DOC_FILE: Relative path to the file in the package %doc directory
# - LICENSE_FILE: Relative path to the file in the package %license directory
#
# The -f option takes precedence over the -D option which takes precedence over
# the -L option, but one of them must be given.
#
%bww_file(f:D:L:)\
%{!?1:%{_error_loc %0: Missing mandatory ID parameter}}\
%{__bww_check_package_id}\
%global __bww_file %{-f*}%{!-f:%{-D:%{_docdir}/%{__bww_package_id}/%{-D*}}%{!-D:%{-L:%{_licensedir}/%{__bww_package_id}/%{-L*}}%{!-L:%{_error_loc %0: Missing mandatory FILE, DOC_FILE or LICENSE_FILE parameter}}}}\
%global __bww_file_id BWW_%{__bww_package_id}_%{1}\
%__bww_guard_package_use_of %{0} %{__bww_file_id}\
%wps_object_create %{__bww_file_id}:WPShadow|%{1}|<%{__bww_folder_id}>|SHADOWID=((%{__bww_file}))\
%{nil}

#
# bww_cleanup:
#
# Delete all WPS objects created by %bww_ macros associated with the package,
# including the package folders
#
# Shared folders are not deleted until the last package using them is removed.
#
# Arguments: none
#
%bww_cleanup()\
%{!?buildfeature_package_context:%{_error_loc %0: Requires BuildFeatures: package-context}}\
%{!?package_scriptlet_postun:%{_error_loc %0: Can appear only in postun context}}\
%global __bww_package_id %{package_name}\
%global __bww_package_key %{_safe_macro_name %{__bww_package_id}}\
%{expand:%%{?__bww_cleaned_up_%{__bww_package_key}:%%{_error_loc %0: Duplicate use for package %{__bww_package_id}}}}\
%{expand:%%global __bww_cleaned_up_%{__bww_package_key} 1}\
%wps_object_delete_all\
%{nil}

#
# Internal macros
#

%__bww_check_package_id\
%{!?__bww_package_id:%{_error_loc %0: Missing preceding bww_folder macro}}\
%{nil}

%__bww_guard_package_use_of()\
%global __bww_package_obj_key %{__bww_package_key}%{_safe_macro_name %{2}}\
%{expand:%%{?__bww_seen_%{__bww_package_obj_key}:%%{_error_loc %1: Duplicate use of Object ID %{2} for package %{__bww_package_id}}}}\
%{expand:%%global __bww_seen_%{__bww_package_obj_key} 1}\
%{nil}